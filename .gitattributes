# Keep text files byte-identical across Windows and Linux checkouts.
* text=auto eol=lf

# Windows-native command files remain CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must remain executable-friendly on Linux.
*.sh text eol=lf

# Explicit binary formats are never line-ending normalized.
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
